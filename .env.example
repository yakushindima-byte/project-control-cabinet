# Пример переменных окружения. В Timeweb App Platform задаются в разделе «Переменные».
# Подключение к PostgreSQL — либо одной строкой:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# либо по отдельности:
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
# 1 — если база требует SSL (обычно при подключении по публичному адресу)
PGSSL=
# Пароль входа в админку /admin.html — не короче 10 символов, придумайте сложный
ADMIN_PASSWORD=
# Порт сервера (по умолчанию 8080)
PORT=8080

# --- Оплата через интернет-эквайринг Т-Банка (Т-Бизнес → Интернет-эквайринг → Магазины → Терминалы)
# Сначала тестовый терминал (ключ оканчивается на DEMO), после проверки — боевой
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Тарифы: дни:цена в рублях[:название], через запятую
PLANS=30:990,365:9900:Год
# Адрес сайта — для ссылок возврата и уведомлений банка
SITE_URL=https://projectcontrol.pro
# Чеки 54-ФЗ через онлайн-кассу Т-Банка: 1 — передавать чек в банк
TBANK_RECEIPT=
# Система налогообложения для чека: osn, usn_income, usn_income_outcome, esn, patent
TBANK_TAXATION=usn_income
# Ставка НДС в чеке: none (без НДС), vat22 (НДС 22%) или другая ставка из справочника Т-Банка
TBANK_TAX=none
# Версия формата фискальных документов: 1.2 или 1.05 (как настроено в кассе)
TBANK_FFD=1.2
